# Conexão do painel e do watchdog. Copie para .env e preencha.
# O .env está no .gitignore: credencial nunca entra no repositório.

# PostgreSQL
GUARDA_DSN="host=servidor.empresa.local port=5432 dbname=loja user=guarda_watchdog password=TROQUE"

# MySQL
# GUARDA_DSN="host=servidor.empresa.local port=3306 user=guarda_watchdog password=TROQUE dbname=guarda"

# SQL Server
# GUARDA_DSN="DRIVER={ODBC Driver 18 for SQL Server};SERVER=servidor;DATABASE=loja;UID=guarda_watchdog;PWD=TROQUE;TrustServerCertificate=yes"

# Use um usuário só do watchdog, e não o da aplicação. Ele precisa de
# privilégio para criar trigger, que é justamente o que a aplicação não
# deveria ter.
